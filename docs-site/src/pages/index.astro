---
// Redirect to docs. This file is overwritten by landing build when deploying combined site.
import BaseLayout from '../layouts/BaseLayout.astro'
const base = Astro.site?.pathname ?? '/'
const baseUrl = base.replace(/\/$/, '')
const docsUrl = `${baseUrl}/docs/overview`
---
<BaseLayout title="Redirect" description="">
  <main style="padding: 48px 24px; text-align: center;">
    <p style="color: var(--color-text-muted);">Redirecting to <a href={docsUrl} style="color: var(--color-accent);">docs</a>…</p>
  </main>
  <script is:inline define:vars={{ docsUrl }}>
    window.location.replace(docsUrl)
  </script>
</BaseLayout>
